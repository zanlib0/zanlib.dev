---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SEO } from 'astro-seo';
import {
	AUTHOR,
	AUTHOR_INTRO,
	OG_LOCALES,
	SITE_TITLE,
	SITE_URL,
	WEBSITE_ID,
	getSiteMetadata,
	type Locale,
} from '../consts';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	translationAvailable?: boolean;
	structuredData?: 'website' | 'profilePage';
	articleMeta?: {
		publishedTime: Date;
		modifiedTime?: Date;
		headline?: string;
	};
}

const currentLocale: Locale = Astro.currentLocale === 'pl' ? 'pl' : 'en';
const siteMetadata = getSiteMetadata(currentLocale);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title = siteMetadata.title,
	description,
	ogImage = '/og/zanlib.png',
	translationAvailable = true,
	structuredData,
	articleMeta,
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.site).href;

const siteTitle = siteMetadata.title;
const fullTitle = title === siteTitle ? siteTitle : `${title} • ${siteTitle}`;

const pathname = Astro.url.pathname;
const isPolish = currentLocale === 'pl';

const [enPath, plPath] = isPolish
  // Polish page: remove /pl prefix for English version
  ? [pathname.replace(/^\/pl/, '') || '/', pathname]
  // English page: add /pl prefix for Polish version
  : [pathname, pathname === '/' ? '/pl/' : `/pl${pathname}`]

const languageAlternates = translationAvailable
	? [
			{ hrefLang: 'en', href: new URL(enPath, Astro.site).href },
			{ hrefLang: 'pl', href: new URL(plPath, Astro.site).href },
			{ hrefLang: 'x-default', href: new URL(enPath, Astro.site).href },
		]
	: undefined;

const aboutURL = new URL(currentLocale === 'pl' ? '/pl/about/' : '/about/', Astro.site).href;
const alternateLocale = currentLocale === 'pl' ? OG_LOCALES.en : OG_LOCALES.pl;

const ogType = articleMeta ? 'article' : 'website';
const openGraphArticle = articleMeta
	? {
			publishedTime: articleMeta.publishedTime.toISOString(),
			modifiedTime: articleMeta.modifiedTime?.toISOString(),
			authors: [aboutURL],
		}
	: undefined;

const person = {
	'@type': 'Person',
	'@id': AUTHOR.id,
	name: AUTHOR.name,
	url: aboutURL,
	description: AUTHOR_INTRO[currentLocale],
	jobTitle: AUTHOR.jobTitle,
	sameAs: AUTHOR.sameAs,
};

let jsonLd: Record<string, unknown> | undefined;

if (articleMeta) {
	jsonLd = {
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'BlogPosting',
				'@id': `${canonicalURL.href}#blogposting`,
				url: canonicalURL.href,
				mainEntityOfPage: {
					'@type': 'WebPage',
					'@id': canonicalURL.href,
				},
				headline: articleMeta.headline ?? title,
				...(description ? { description } : {}),
				image: ogImageUrl,
				datePublished: articleMeta.publishedTime.toISOString(),
				...(articleMeta.modifiedTime
					? { dateModified: articleMeta.modifiedTime.toISOString() }
					: {}),
				inLanguage: currentLocale,
				author: { '@id': AUTHOR.id },
				isPartOf: { '@id': WEBSITE_ID },
			},
			person,
		],
	};
} else if (structuredData === 'profilePage') {
	jsonLd = {
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'ProfilePage',
				'@id': `${canonicalURL.href}#profilepage`,
				url: canonicalURL.href,
				name: title,
				inLanguage: currentLocale,
				mainEntity: { '@id': AUTHOR.id },
			},
			person,
		],
	};
} else if (structuredData === 'website') {
	jsonLd = {
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': WEBSITE_ID,
		url: SITE_URL,
		name: SITE_TITLE,
	};
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteMetadata.title}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/eb-garamond.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/eb-garamond-italic.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/ysabeau-vf.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/league-mono-vf.woff" as="font" type="font/woff" crossorigin />

<!-- SEO: title, description, canonical, Open Graph, Twitter, hreflang -->
<SEO
	title={fullTitle}
	description={description}
	canonical={canonicalURL.href}
	openGraph={{
		basic: {
			title: fullTitle,
			type: ogType,
			url: canonicalURL.href,
			image: ogImageUrl,
		},
		optional: {
			description,
			locale: OG_LOCALES[currentLocale],
			localeAlternate: translationAvailable ? [alternateLocale] : undefined,
			siteName: SITE_TITLE,
		},
		article: openGraphArticle,
	}}
	twitter={{
		card: 'summary_large_image',
		title: fullTitle,
		description,
		image: ogImageUrl,
		creator: AUTHOR.twitterHandle,
	}}
	languageAlternates={languageAlternates}
	extend={{
		meta: [{ name: 'author', content: AUTHOR.name }],
	}}
/>

{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<script
	is:inline
	defer
	src="https://stats.zanlib.dev/script.js"
	data-website-id="e6a8daa2-2a7e-4774-be87-5f4806219028"></script>
