---
import BaseHead from '../components/BaseHead.astro';
import Bio from '../components/Bio.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { formatDate } from '../utils/formatDate';
import '../styles/marginnotes.css';
import '../styles/blogpost.css';

type Props = {
	title?: string,
	description?: string,
	pubDate: Date,
	updatedDate?: Date,
	wip?: boolean,
	collection: 'articles' | 'notes' | 'jots',
	slug?: string,
	translationAvailable?: boolean,
	t: {
		lastUpdatedText: string;
		navLinks: {
			articles: string;
			projects: string;
			about: string;
		};
	};
};

const { title, description, pubDate, updatedDate, collection, slug, wip = false, translationAvailable, t } = Astro.props;
const currentLocale = Astro.currentLocale || 'en';
const isJot = collection === 'jots';
const jotPrefix = currentLocale === 'pl' ? 'Szkic' : 'Jot';
const formattedPubDate = formatDate(pubDate, currentLocale);
const postTitle = isJot ? `${jotPrefix}, ${formattedPubDate}` : title!;

const articleMeta = {
	publishedTime: pubDate,
	modifiedTime: updatedDate,
	headline: postTitle,
};

const ogImage = slug ? `/og/${currentLocale}/${slug}.png` : undefined;

type DateLineItem = {
	date: Date;
	prefix?: string;
	className?: string;
};

const dateLineItems: DateLineItem[] = [];

if (!isJot) {
	dateLineItems.push({ date: pubDate });
}

if (updatedDate) {
	const separator = dateLineItems.length > 0 ? '• ' : '';

	dateLineItems.push({
		date: updatedDate,
		prefix: `${separator}${t.lastUpdatedText} `,
		className: 'last-updated-on',
	});
}
---
<html lang={currentLocale}>
	<head>
		<BaseHead
			title={postTitle}
			description={description}
			ogImage={ogImage}
			articleMeta={articleMeta}
			{translationAvailable}
		/>
	</head>

	<body>
		<Header active="blog" navLinks={t.navLinks} {slug} {translationAvailable} />
		<main>
			<article class={collection}>
				<div class="prose">
					<div class="title">
						{
							isJot ? (
								<h1 class="jot-title"><span class="sr-only">{jotPrefix}, </span>{formattedPubDate}</h1>
							) : (
								<h1>{postTitle}</h1>
							)
						}
						{
							dateLineItems.length > 0 && (
								<div class="date">
									<h6>
										{dateLineItems.map(({ date, prefix, className }) => (
											<span class={className}>
												{prefix}<FormattedDate {date} />
											</span>
										))}
									</h6>
								</div>
							)
						}
						<hr />
					</div>
					{wip && (
						<div class="wip">
							This article is unlisted and still a work in progress.
						</div>
					)}
					<slot />
					{(collection === 'articles' || collection === 'notes') && <Bio />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
main {
	width: calc(100% - 2em);
	max-width: 100%;
	margin: 0;
}

article.articles {
	font-family: var(--body-font);
}

article.notes {
	font-family: var(--sans-font);
	letter-spacing: -0.03rem;
	font-variant-ligatures: no-discretionary-ligatures contextual;
	font-feature-settings: "liga" 1, "clig" 1, "calt" 1;

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--sans-font);
	}
}

article.jots {
	font-family: var(--mono-font);
	font-size: 0.8rem;
	line-height: 1.2;

	h6 {
		font-size: inherit;
	}

	code {
		font-size: 0.8rem;
	}
}

.prose {
	width: 720px;
	max-width: calc(100% - 2em);
	margin: auto;
	padding: 1em;
	color: rgb(var(--gray-dark));
}

.wip {
  font-size: 1rem;
  width: 100%;
  background: var(--brand-1);
  border: 1px solid var(--brand-2);
  padding: 0.5rem;
  text-align: center;
}

/* Adjust prose width on large screens to accommodate margin notes */
@media (min-width: 1280px) {
	.prose {
		width: 55%;
		max-width: 720px;
	}
}
.title {
	margin-bottom: 1em;
	padding: 1em 0;
	text-align: center;
	line-height: 1;
}
.title h1 {
	margin: 0 0 1rem 0;
}
.title h1.jot-title {
	margin: 0 0 0.5rem 0;
	color: var(--foreground-subtle);
	font-family: var(--sans-font);
	font-size: inherit;
	font-weight: 700;
	letter-spacing: 0.2em;
	text-transform: uppercase;
}
.date {
	margin-bottom: 0.5em;
	color: rgb(var(--gray));
}
</style>
