---
import HomePage from '../components/pages/HomePage.astro';
import { AUTHOR, AUTHOR_INTRO, PAGE_METADATA } from '../consts';
import { getNavLinks } from '../i18n/ui';

const t = {
	lang: 'en' as const,
	...PAGE_METADATA.en.home,
	portraitAlt: 'Portrait',
	subtitle: AUTHOR.jobTitle,
	paragraph1: AUTHOR_INTRO.en,
	contactHeading: 'Get in touch',
	bookAMeeting: 'Book a meeting',
	navLinks: getNavLinks('en'),
};
---

<HomePage {t} />
