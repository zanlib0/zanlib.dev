---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { getNavLinks } from '../i18n/ui';

const navLinks = getNavLinks('en');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="404"
			description="The requested page was not found."
			noindex
			translationAvailable={false}
		/>
	</head>
	<body>
		<Header active="404" {navLinks} />

		<main>
			<section class="sand-field" data-sand-field>
				<h1>404</h1>

				<canvas
					data-canvas
					tabindex="0"
					role="button"
					aria-label="Unsorted sand. Activate to sort the grains by hue."
				></canvas>

				<blockquote>
					<p>
						“We take a handful of sand from the endless landscape of awareness around us and call that handful of sand the world.”
					</p>
					<cite>
						&mdash; Robert Pirsig, <em>Zen and the Art of Motorcycle Maintenance</em>
					</cite>
				</blockquote>
			</section>
		</main>

		<script>
			type Arrangement = 'random' | 'hue' | 'size' | 'shape';

			type Grain = {
				hue: number;
				size: number;
				shape: number;
				angle: number;
				xSeed: number;
				ySeed: number;
				currentX: number;
				currentY: number;
				fromX: number;
				fromY: number;
				targetX: number;
				targetY: number;
			};

			const field = document.querySelector<HTMLElement>('[data-sand-field]');
			const canvas = field?.querySelector<HTMLCanvasElement>('[data-canvas]');
			const context = canvas?.getContext('2d');

			if (field && canvas && context) {
				const drawingContext = context;
				const arrangements: Arrangement[] = ['random', 'hue', 'size', 'shape'];
				const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				const goldenAngle = Math.PI * (3 - Math.sqrt(5));
				let arrangement: Arrangement = 'random';
				let width = 0;
				let height = 0;
				let animationStart = 0;
				let animationFrame = 0;
				let randomState = hash(window.location.pathname);

				function hash(value: string) {
					let result = 2166136261;
					for (let index = 0; index < value.length; index += 1) {
						result ^= value.charCodeAt(index);
						result = Math.imul(result, 16777619);
					}
					return result >>> 0;
				}

				function random() {
					randomState += 0x6d2b79f5;
					let result = randomState;
					result = Math.imul(result ^ (result >>> 15), result | 1);
					result ^= result + Math.imul(result ^ (result >>> 7), result | 61);
					return ((result ^ (result >>> 14)) >>> 0) / 4294967296;
				}

				const grains: Grain[] = Array.from({ length: 404 }, () => ({
					hue: Math.floor(random() * 4),
					size: Math.floor(random() * 3),
					shape: Math.floor(random() * 3),
					angle: random() * Math.PI,
					xSeed: random(),
					ySeed: random(),
					currentX: 0,
					currentY: 0,
					fromX: 0,
					fromY: 0,
					targetX: 0,
					targetY: 0,
				}));

				const categoryOf = (grain: Grain) => {
					if (arrangement === 'hue') return grain.hue;
					if (arrangement === 'size') return grain.size;
					return grain.shape;
				};

				const positionFor = (grain: Grain) => {
					const padding = Math.min(48, width * 0.07);
					const top = Math.min(150, height * 0.2);
					const bottom = Math.min(190, height * 0.25);

					if (arrangement === 'random') {
						return {
							x: padding + grain.xSeed * (width - padding * 2),
							y: top + grain.ySeed * Math.max(80, height - top - bottom),
						};
					}

					const categoryCount = arrangement === 'hue' ? 4 : 3;
					const category = categoryOf(grain);
					const group = grains.filter((candidate) => categoryOf(candidate) === category);
					const rank = group.indexOf(grain);
					const radius = Math.sqrt((rank + 1) / group.length);
					const angle = rank * goldenAngle + grain.angle * 0.2;
					const availableHeight = Math.max(180, height - top - bottom);
					const spread = Math.min(width / categoryCount, availableHeight) * 0.36;

					return {
						x: ((category + 0.5) / categoryCount) * width + Math.cos(angle) * radius * spread,
						y: top + availableHeight / 2 + Math.sin(angle) * radius * spread,
					};
				};

				const colors = () => {
					const styles = getComputedStyle(field);
					return [1, 2, 3, 4].map((number) => styles.getPropertyValue(`--grain-${number}`).trim());
				};

				const drawGrain = (grain: Grain, color: string) => {
					const radius = 1.8 + grain.size * 1.15;

					drawingContext.save();
					drawingContext.translate(grain.currentX, grain.currentY);
					drawingContext.rotate(grain.angle);
					drawingContext.fillStyle = color;
					drawingContext.beginPath();

					if (grain.shape === 0) {
						drawingContext.ellipse(0, 0, radius * 1.45, radius * 0.72, 0, 0, Math.PI * 2);
					} else if (grain.shape === 1) {
						drawingContext.arc(0, 0, radius, 0, Math.PI * 2);
					} else {
						drawingContext.moveTo(-radius, radius * 0.72);
						drawingContext.lineTo(-radius * 0.5, -radius);
						drawingContext.lineTo(radius, -radius * 0.35);
						drawingContext.lineTo(radius * 0.7, radius * 0.9);
						drawingContext.closePath();
					}

					drawingContext.fill();
					drawingContext.restore();
				};

				function draw(timestamp = performance.now()) {
					const duration = 800;
					const progress = animationStart ? Math.min(1, (timestamp - animationStart) / duration) : 1;
					const eased = 1 - Math.pow(1 - progress, 3);
					const palette = colors();

					drawingContext.clearRect(0, 0, width, height);

					grains.forEach((grain) => {
						if (progress < 1) {
							grain.currentX = grain.fromX + (grain.targetX - grain.fromX) * eased;
							grain.currentY = grain.fromY + (grain.targetY - grain.fromY) * eased;
						}
						drawGrain(grain, palette[grain.hue]);
					});

					if (progress < 1) {
						animationFrame = requestAnimationFrame(draw);
					} else {
						animationStart = 0;
					}
				}

				const setTargets = (animate = true) => {
					grains.forEach((grain) => {
						grain.fromX = grain.currentX;
						grain.fromY = grain.currentY;
						const target = positionFor(grain);
						grain.targetX = target.x;
						grain.targetY = target.y;
						if (!animate || reducedMotion.matches) {
							grain.currentX = target.x;
							grain.currentY = target.y;
						}
					});

					animationStart = animate && !reducedMotion.matches ? performance.now() : 0;
					cancelAnimationFrame(animationFrame);
					draw();
				};

				const cycle = () => {
					const index = arrangements.indexOf(arrangement);
					arrangement = arrangements[(index + 1) % arrangements.length];

					if (arrangement === 'random') {
						grains.forEach((grain) => {
							grain.xSeed = random();
							grain.ySeed = random();
						});
					}

					const nextIndex = (arrangements.indexOf(arrangement) + 1) % arrangements.length;
					const next = arrangements[nextIndex];
					canvas.setAttribute(
						'aria-label',
						`${arrangement === 'random' ? 'Unsorted' : `Sorted by ${arrangement}`} sand. Activate to ${next === 'random' ? 'reshuffle the grains' : `sort the grains by ${next}`}.`,
					);
					setTargets();
				};

				const resize = () => {
					const rect = canvas.getBoundingClientRect();
					const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
					width = rect.width;
					height = rect.height;
					canvas.width = Math.round(width * pixelRatio);
					canvas.height = Math.round(height * pixelRatio);
					drawingContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
					setTargets(false);
				};

				canvas.addEventListener('click', cycle);
				canvas.addEventListener('keydown', (event) => {
					if (event.key !== 'Enter' && event.key !== ' ') return;
					event.preventDefault();
					cycle();
				});

				new ResizeObserver(resize).observe(canvas);
				new MutationObserver(() => draw()).observe(document.documentElement, {
					attributes: true,
					attributeFilter: ['class'],
				});
			}
		</script>
	</body>
</html>

<style>
	:global(body) {
		min-width: 300px;
	}

	main {
		width: 100%;
		max-width: none;
		padding: 0;
	}

	.sand-field {
		--grain-1: oklch(0.78 0.035 72);
		--grain-2: oklch(0.63 0.085 61);
		--grain-3: oklch(0.47 0.055 46);
		--grain-4: var(--brand-7);
		position: relative;
		min-height: 680px;
		height: calc(100svh - 155px);
		background: var(--background);
		overflow: hidden;
	}

	:global(html.dark) .sand-field {
		--grain-1: oklch(0.71 0.032 72);
		--grain-2: oklch(0.69 0.09 61);
		--grain-3: oklch(0.65 0.05 46);
		--grain-4: var(--brand-7);
	}

	h1 {
		position: absolute;
		z-index: 1;
		top: 50%;
		left: 50%;
		margin: 0;
		color: var(--foreground-surface);
		font-family: var(--heading-font);
		font-size: clamp(7rem, 16vw, 14rem);
		font-weight: 100;
		line-height: 0.8;
		letter-spacing: -0.07em;
		transform: translate(-50%, -100%);
		pointer-events: none;
		opacity: 0.8;
	}

	canvas {
		display: block;
		width: 100%;
		height: 100%;
		cursor: pointer;
		touch-action: manipulation;
	}

	canvas:focus-visible {
		outline: 2px solid var(--brand-7);
		outline-offset: -4px;
	}

	blockquote {
		position: absolute;
		z-index: 1;
		bottom: clamp(1.5rem, 4vh, 3rem);
		left: 50%;
		width: min(760px, calc(100% - 3rem));
		margin: 0;
		padding: 0;
		border: 0;
		text-align: center;
		transform: translateX(-50%);
		pointer-events: none;
	}

	blockquote p {
		margin: 0 0 0.65rem;
		font-size: clamp(1.15rem, 2vw, 1.55rem);
		font-style: italic;
		line-height: 1.35;
	}

	blockquote cite {
		display: block;
		color: var(--foreground-subtle);
		font-family: var(--sans-font);
		font-size: 0.78rem;
		font-style: normal;
		letter-spacing: 0.015em;
	}

	@media (max-width: 550px) {
		.sand-field {
			min-height: 620px;
			height: calc(100svh - 175px);
		}

		h1 {
			font-size: clamp(7rem, 38vw, 10rem);
		}

		blockquote {
			bottom: 1.75rem;
		}

		blockquote p {
			font-size: 1.05rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		canvas {
			scroll-behavior: auto;
		}
	}
</style>
